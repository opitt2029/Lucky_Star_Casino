# Lucky Star Casino - Closed Beta environment template
#
# Copy this file to .env on the beta host, replace every CHANGE_ME value, and
# keep the resulting .env out of version control.
#
# Suggested secret generation:
#   openssl rand -base64 48
#
# Closed beta defaults:
# - Real backend only: VITE_USE_MOCK_API=false
# - No automatic admin seed in a running beta: ADMIN_SEED_ENABLED=false
# - Internal service ports are not published when docker-compose.beta.yml is used

PROJECT_NAME=lucky_star_casino_beta

# Databases
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=lucky_star_casino
MYSQL_USER=lucky_user
MYSQL_PASSWORD=CHANGE_ME
MYSQL_HOST=localhost
MYSQL_PORT=3307

POSTGRES_DB=lucky_star_casino
POSTGRES_USER=lucky_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_PORT=9092
KAFKA_UI_PORT=8085
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLUSTER_ID=CHANGE_ME

# Frontend / Gateway
FRONTEND_PORT=5173
VITE_API_BASE_URL=https://CHANGE_ME.example.com
VITE_WS_URL=wss://CHANGE_ME.example.com/ws
VITE_USE_MOCK_API=false
VITE_ENABLE_DEV_TOOLS=false
VITE_DEMO_MODE=false
VITE_DEMO_USERNAME=
VITE_DEMO_PASSWORD=

# If gateway is behind a reverse proxy on the same host, keep 127.0.0.1.
# Use 0.0.0.0 only when the host firewall/load balancer is already locked down.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080

MEMBER_SERVICE_PORT=8081
WALLET_SERVICE_PORT=8082
GAME_SERVICE_PORT=8083
RANK_SERVICE_PORT=8084
ADMIN_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087

# Secrets
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000
ADMIN_JWT_SECRET=CHANGE_ME
ADMIN_JWT_EXPIRY_MS=3600000
INTERNAL_SECRET=CHANGE_ME
INTERNAL_SERVICE_SECRET=CHANGE_ME

# Admin account
# Closed beta should use a manually managed admin account. If initial seeding is
# needed on a fresh database, temporarily set true, start once, rotate password,
# then set false again.
ADMIN_SEED_ENABLED=false
ADMIN_SEED_USERNAME=CHANGE_ME
ADMIN_SEED_PASSWORD=CHANGE_ME

# Service URLs for host-native runs. Docker compose overrides these internally.
MEMBER_SERVICE_URL=http://localhost:8081
WALLET_SERVICE_URL=http://localhost:8082
GAME_SERVICE_URL=http://localhost:8083
RANK_SERVICE_URL=http://localhost:8084
ADMIN_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_URL=http://localhost:8087

# Restrict to the actual beta player/admin origins.
CORS_ALLOWED_ORIGINS=https://CHANGE_ME.example.com,https://admin.CHANGE_ME.example.com

# OAuth, optional
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=oauth-not-configured
GOOGLE_CLIENT_SECRET=oauth-not-configured
LINE_OAUTH_ENABLED=false
LINE_CHANNEL_ID=oauth-not-configured
LINE_CHANNEL_SECRET=oauth-not-configured
APPLE_OAUTH_ENABLED=false
APPLE_CLIENT_ID=oauth-not-configured
APPLE_CLIENT_SECRET=oauth-not-configured
APPLE_REDIRECT_URI=https://CHANGE_ME.example.com/api/v1/auth/oauth2/callback/apple
OAUTH_PUBLIC_BASE_URL=https://CHANGE_ME.example.com
OAUTH_FRONTEND_BASE_URL=https://CHANGE_ME.example.com

# JPA / logging
JPA_DDL_AUTO=validate
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=OFF
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_GATEWAY=INFO

# Closed beta throttling. Tune only after smoke and capacity checks.
AUTH_RATE_LIMIT_REPLENISH=5
AUTH_RATE_LIMIT_BURST=10
PLAYER_RATE_LIMIT_REPLENISH=10
PLAYER_RATE_LIMIT_BURST=20
GAME_RATE_LIMIT_REPLENISH=5
GAME_RATE_LIMIT_BURST=10
